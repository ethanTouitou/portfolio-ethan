---
import Layout from "../../layouts/Layout.astro";
import { fetchProjects, defaultPbUrl } from "../../lib/pocketbase";

const pbUrl = defaultPbUrl;
const projects = await fetchProjects(pbUrl, 24);
---

<Layout>
	<section
		class="relative isolate overflow-hidden bg-gradient-to-b from-[#050d1f] via-[#020817] to-[#010309] px-6 py-20 text-white"
	>
		<div class="pointer-events-none absolute inset-0 opacity-40">
			<div class="absolute left-0 top-0 h-56 w-56 rounded-full bg-emerald-500/10 blur-[150px]"></div>
			<div class="absolute right-0 bottom-0 h-64 w-64 rounded-full bg-blue-500/10 blur-[160px]"></div>
		</div>

		<div class="relative mx-auto max-w-6xl space-y-10">
			<div class="space-y-3 text-center">
				<p class="text-xs uppercase tracking-[0.3em] text-emerald-300/70">
					Portfolio
				</p>
				<h1 class="text-3xl font-semibold sm:text-4xl">Mes Projets</h1>
				<p class="text-base text-white/70">
					Une sélection de projets techniques et créatifs. De nouveaux cas d'usage seront ajoutés au fur et à mesure.
				</p>
			</div>

			<div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
				{
					projects.map((project) => (
						<article
							class="flex flex-col overflow-hidden rounded-3xl border border-white/10 bg-white/5 shadow-[0_18px_60px_rgba(2,8,23,0.55)]"
						>
							<div class="h-40 w-full overflow-hidden bg-[#0f172a]">
								{
									project.coverUrl ? (
										<img
											src={project.coverUrl}
											alt={project.titre ?? "Projet"}
											class="h-full w-full object-cover"
											loading="lazy"
										/>
									) : (
										<div class="flex h-full items-center justify-center text-white/50">
											Visuel du projet
										</div>
									)
								}
							</div>
							<div class="flex flex-1 flex-col space-y-4 px-5 py-6 text-left">
								<div class="space-y-1">
									<h3 class="text-lg font-semibold">
										{project.titre ?? "Projet sans titre"}
									</h3>
									<p class="text-sm text-white/70">
										{project.subtitle ?? "Description à venir."}
									</p>
								</div>
								<div class="flex flex-wrap gap-2">
									{
										(project.tags ?? [])
											.slice(0, 5)
											.map((tag) => (
												<span class="rounded-full bg-emerald-500/15 px-3 py-1 text-xs font-medium text-emerald-200">
													{tag}
												</span>
											))
									}
								</div>
								<div class="mt-auto">
									<a
										href="/emminant/"
										class="inline-flex items-center gap-2 text-sm font-semibold text-emerald-300 transition hover:text-emerald-200"
									>
										En savoir plus
										<span aria-hidden="true">↗</span>
									</a>
								</div>
							</div>
						</article>
					))
				}
			</div>
		</div>
	</section>
</Layout>
